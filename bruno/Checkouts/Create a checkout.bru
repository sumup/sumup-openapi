example {
  name: HostedCheckout
  description: Response body for a checkout with a SumUp-hosted payment page
  
  request: {
    url: {{baseUrl}}/v0.1/checkouts
    method: POST
    mode: json
    body:json: {
      {
        "checkout_reference": "b50pr914-6k0e-3091-a592-890010285b3d",
        "amount": 12,
        "currency": "EUR",
        "merchant_code": "MCXXXXXX",
        "description": "A sample checkout",
        "hosted_checkout": {
          "enabled": true
        },
        "redirect_url": "https://example.com/orders/123/complete"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "checkout_reference": "b50pr914-6k0e-3091-a592-890010285b3d",
          "amount": 12,
          "currency": "EUR",
          "merchant_code": "MCXXXXXX",
          "merchant_country": "DE",
          "merchant_name": "Sample Shop",
          "description": "A sample checkout",
          "id": "64553e20-3f0e-49e4-8af3-fd0eca86ce91",
          "status": "PENDING",
          "date": "2000-01-01T12:49:24.899+00:00",
          "purpose": "CHECKOUT",
          "hosted_checkout": {
            "enabled": true
          },
          "hosted_checkout_url": "https://checkout.sumup.com/pay/8f9316a3-cda9-42a9-9771-54d534315676",
          "transactions": []
        }
      '''
    }
  }
}

example {
  name: Checkout for saving a card
  
  request: {
    url: {{baseUrl}}/v0.1/checkouts
    method: POST
    mode: json
    body:json: {
      {
        "checkout_reference": "save-card-123",
        "amount": 1,
        "currency": "EUR",
        "merchant_code": "MCXXXXXX",
        "description": "Save a card for future payments",
        "customer_id": "831ff8d4cd5958ab5670",
        "purpose": "SETUP_RECURRING_PAYMENT"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "checkout_reference": "save-card-123",
          "amount": 1,
          "currency": "EUR",
          "merchant_code": "MCXXXXXX",
          "description": "Save a card for future payments",
          "customer_id": "831ff8d4cd5958ab5670",
          "purpose": "SETUP_RECURRING_PAYMENT",
          "id": "7164c99b-13cb-42a1-8ba1-3c2c46a29de7",
          "status": "PENDING",
          "date": "2026-10-30T12:00:00+00:00",
          "transactions": []
        }
      '''
    }
  }
}

