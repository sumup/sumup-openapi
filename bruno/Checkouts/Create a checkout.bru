example {
  name: Problem_Details (Checkout)
  description: Unauthorized response returned by API gateway.
  
  request: {
    url: {{baseUrl}}/v0.1/checkouts
    method: POST
    mode: json
    body:json: {
      {
        "checkout_reference": "f00a8f74-b05d-4605-bd73-2a901bae5802",
        "amount": 10.1,
        "currency": "EUR",
        "merchant_code": "MH4H92C7",
        "description": "Purchase",
        "valid_until": "2030-12-31T23:59:59Z",
        "redirect_url": "https://sumup.com"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "detail": "Unauthorized.",
          "status": 401,
          "title": "Unauthorized",
          "trace_id": "3c77294349d3b5647ea2d990f0d8f017",
          "type": "https://developer.sumup.com/problem/unauthorized"
        }
      '''
    }
  }
}

