  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "error_message": "checkout_payments_not_allowed",
          "error_code": "FORBIDDEN",
          "status_code": "403"
        }
      '''
    }
  }
}

