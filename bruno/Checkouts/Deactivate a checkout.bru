example {
  name: Checkout_Processed
  description: The identified checkout resource is already processed.
  
  request: {
    url: {{baseUrl}}/v0.1/checkouts/:checkout_id
    method: DELETE
    mode: none
    params:path: {
      checkout_id: 4e425463-3e1b-431d-83fa-1e51c2925e99
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "error_code": "CHECKOUT_PROCESSED",
          "message": "Checkout is already processed"
        }
      '''
    }
  }
}
