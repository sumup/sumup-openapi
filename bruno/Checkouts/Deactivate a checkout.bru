meta {
  name: Deactivate a checkout
  type: http
  seq: 7
  tags: [
    Checkouts
  ]
}

delete {
  url: {{baseUrl}}/v0.1/checkouts/:checkout_id
  body: none
  auth: inherit
}

params:path {
  @description('SumUp-generated `id` returned when creating a checkout. Use this value to retrieve, update, process, or deactivate the checkout.')
  checkout_id: 4e425463-3e1b-431d-83fa-1e51c2925e99
}

docs {
  Deactivates an identified checkout resource. If the checkout has already been processed it can not be deactivated.
}

example {
  name: 200 Response
  description: Returns the checkout object after successful deactivation.
  
  request: {
    url: {{baseUrl}}/v0.1/checkouts/:checkout_id
    method: DELETE
    mode: none
    params:path: {
      checkout_id: 4e425463-3e1b-431d-83fa-1e51c2925e99
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "checkout_reference": "f00a8f74-b05d-4605-bd73-2a901bae5802",
          "id": "817340ce-f1d9-4609-b90a-6152f8ee267a",
          "amount": 2,
          "currency": "EUR",
          "merchant_code": "MH4H92C7",
          "description": "Deletion example",
          "purpose": "CHECKOUT",
          "status": "EXPIRED",
          "date": "2020-02-29T10:56:56+00:00",
          "valid_until": "2030-12-31T23:59:59Z",
          "merchant_name": "Sample Merchant",
          "transactions": []
        }
      '''
    }
  }
}

