example {
  name: 202 Response (ProcessCard)
  description: Returns the next required action for asynchronous checkout processing.
  
  request: {
    url: {{baseUrl}}/v0.1/checkouts/:checkout_id
    method: PUT
    mode: json
    params:path: {
      checkout_id: 4e425463-3e1b-431d-83fa-1e51c2925e99
    }
  
    body:json: {
      {
        "payment_type": "card",
        "installments": 1,
        "mandate": {
          "type": "recurrent",
          "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/88.0.4324.104 Safari/537.36",
          "user_ip": "172.217.169.174"
        },
        "card": {
          "type": "VISA",
          "name": "John Doe",
          "number": "1234567890123456",
          "expiry_year": "2023",
          "expiry_month": "01",
          "cvv": "123",
          "zip_code": "12345"
        }
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 202
      text: Accepted
    }
  
    body: {
      type: json
      content: '''
        {
          "next_step": {
            "url": "https://dummy-3ds-gateway.com/cap?RID=1233&VAA=A",
            "method": "POST",
            "redirect_url": "https://mysite.com/completed_purchase",
            "mechanism": [
              "iframe"
            ],
            "payload": {
              "PaReq": "",
              "MD": "b1a536c0-29b9-11eb-adc1-0242ac120002",
              "TermUrl": "https://api.sumup.com/v0.1/checkouts/e552de3b-1777-4c91-bdb8-756967678572/complete_payment"
            }
          }
        }
      '''
    }
  }
}

