meta {
  name: Create a customer
  type: http
  seq: 1
  tags: [
    Customers
  ]
}

post {
  url: {{baseUrl}}/v0.1/customers
  body: json
  auth: inherit
}

body:json {
  {
    "customer_id": "831ff8d4cd5958ab5670",
    "personal_details": {
      "first_name": "John",
      "last_name": "Doe",
      "email": "user@example.com",
      "phone": "+491635559723",
      "birth_date": "1993-12-31",
      "tax_id": "423.378.593-47",
      "address": {
        "city": "Berlin",
        "country": "DE",
        "line_1": "Sample street",
        "line_2": "ap. 5",
        "postal_code": "10115",
        "state": "Berlin"
      }
    }
  }
}

docs {
  Creates a customer using the `customer_id` you supply. Choose an identifier that maps to the payer in your own system and reuse it when retrieving the customer or associating checkouts and saved payment instruments with them.
}

example {
  name: 201 Response
  description: Returns the customer resource.
  
  request: {
    url: {{baseUrl}}/v0.1/customers
    method: POST
    mode: json
    body:json: {
