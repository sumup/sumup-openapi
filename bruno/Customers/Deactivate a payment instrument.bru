delete {
  url: {{baseUrl}}/v0.1/customers/:customer_id/payment-instruments/:token
  body: none
  auth: inherit
}

params:path {
  @description('The `customer_id` you supplied when creating the customer.')
  customer_id: 831ff8d4cd5958ab5670
  @description('Unique token identifying the card saved as a payment instrument resource.')
  token: bcfc8e5f-3b47-4cb9-854b-3b7a4cce7be3
}

docs {
  Deactivates an identified card payment instrument resource for a customer.
}

