meta {
  name: List payment instruments
  type: http
  seq: 4
  tags: [
    Customers
  ]
}

get {
  url: {{baseUrl}}/v0.1/customers/:customer_id/payment-instruments
  body: none
  auth: inherit
}

params:path {
  @description('The `customer_id` you supplied when creating the customer.')
  customer_id: 831ff8d4cd5958ab5670
}

docs {
  Lists all payment instrument resources that are saved for an identified customer.
}

example {
  name: 200 Response
  description: Returns the list of saved payment instruments for the customer.
  
  request: {
    url: {{baseUrl}}/v0.1/customers/:customer_id/payment-instruments
    method: GET
    mode: none
    params:path: {
      customer_id: 831ff8d4cd5958ab5670
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        [
          {
            "token": "bcfc8e5f-3b47-4cb9-854b-3b7a4cce7be3",
            "active": false,
            "type": "card",
            "card": {
              "last_4_digits": "3456",
              "type": "VISA"
            },
            "mandate": {
              "type": "recurrent",
              "status": "active",
              "merchant_code": "MH4H92C7"
            },
            "created_at": "2021-03-30T10:06:07.000+00:00"
          }
        ]
      '''
    }
  }
}

