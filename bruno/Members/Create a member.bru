meta {
  name: Create a member
  type: http
  seq: 2
  tags: [
    Members
  ]
}

post {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/members
  body: json
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
}

body:json {
  {
    "email": "karl.berg@example.com",
    "roles": [
      "role_employee"
    ]
  }
}

docs {
  Adds a member to the merchant account with the specified roles.
  
  By default, sends an invitation email to the provided address. The recipient must accept the invitation to join the account.
  When `is_managed_user` is `true`, creates a managed user with the provided password and optional nickname and assigns the roles directly, without sending an invitation.
}

example {
  name: 201 Response
  description: Returns the Member object if the creation succeeded.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/members
    method: POST
    mode: json
    params:path: {
      merchant_code: MK10CL2A
    }
  
    body:json: {
      {
        "email": "karl.berg@example.com",
        "roles": [
          "role_employee"
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "mem_WZsm7QTPhVrompscmPhoGTXXcrd58fr9MOhP",
          "roles": [
            "role_admin",
            "role_owner"
          ],
          "permissions": [
            "members_read",
            "members_write",
            "create_moto_payments",
            "full_transaction_history_view",
            "refund_transactions",
            "create_referral",
            "developer_settings_edit",
            "developer_settings_access"
          ],
          "created_at": "2023-01-20T15:16:17Z",
          "updated_at": "2023-02-20T15:16:17Z",
          "user": {
            "id": "44ca0f5b-813b-46e1-aee7-e6242010662e",
            "email": "example@sumup.com",
            "mfa_on_login_enabled": true,
            "virtual_user": false,
            "service_account_user": false
          },
          "status": "accepted"
        }
      '''
    }
  }
}

