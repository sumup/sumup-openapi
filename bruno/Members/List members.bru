example {
  name: 404 Response
  description: Merchant not found.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/members
    method: GET
    mode: none
    params:query: {
      offset: 0
      limit: 10
      scroll: false
      email: user
      user.id: 245b2ead-85bf-45ff-856f-311a88a5d454
      ~status: accepted
      ~status: pending
      ~status: expired
      ~status: disabled
      ~status: unknown
      roles: role_employee,role_accountant
    }
  
    params:path: {
      merchant_code: MK10CL2A
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/not-found",
          "title": "Requested resource couldn't be found.",
          "status": 404,
          "detail": "The requested resource doesn't exist or does not belong to you."
        }
      '''
    }
  }
}
