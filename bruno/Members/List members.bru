meta {
  name: List members
  type: http
  seq: 1
  tags: [
    Members
  ]
}

get {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/members
  body: none
  auth: inherit
}

params:query {
  @description('Offset of the first member to return.')
  offset: 0
  @description('Maximum number of members to return.')
  limit: 10
  @description('Indicates to skip count query.')
  scroll: false
  @description('Filter the returned members by email address prefix.')
  email: user
  @description('Search for a member by user id.')
  user.id: 245b2ead-85bf-45ff-856f-311a88a5d454
  @description('Filter the returned members by role.')
  roles: role_employee,role_accountant
  @description('Filter the returned members by the membership status.')
  ~status: accepted
  @description('Filter the returned members by the membership status.')
  ~status: pending
  @description('Filter the returned members by the membership status.')
  ~status: expired
  @description('Filter the returned members by the membership status.')
  ~status: disabled
  @description('Filter the returned members by the membership status.')
  ~status: unknown
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
}

docs {
  Lists merchant members.
}

example {
  name: 200 Response
  description: Returns a list of Member objects.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/members
    method: GET
    mode: none
    params:query: {
      offset: 0
      limit: 10
      scroll: false
      email: user
      user.id: 245b2ead-85bf-45ff-856f-311a88a5d454
      ~status: accepted
      ~status: pending
      ~status: expired
      ~status: disabled
      ~status: unknown
      roles: role_employee,role_accountant
    }
  
    params:path: {
      merchant_code: MK10CL2A
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "items": [
            {
              "id": "mem_WZsm7QTPhVrompscmPhoGTXXcrd58fr9MOhP",
              "roles": [
                "role_admin"
              ],
              "permissions": [
                "members_read",
                "members_write",
                "create_moto_payments",
