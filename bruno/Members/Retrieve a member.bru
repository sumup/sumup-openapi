meta {
  name: Retrieve a member
  type: http
  seq: 3
  tags: [
    Members
  ]
}

get {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/members/:member_id
  body: none
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
  @description('The ID of the member to retrieve.')
  member_id: mem_WZsm7QTPhVrompscmPhoGTXXcrd58fr9MOhP
}

docs {
  Retrieve a merchant member.
}

example {
  name: 200 Response
  description: Returns the Member object for a valid identifier.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/members/:member_id
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
      member_id: mem_WZsm7QTPhVrompscmPhoGTXXcrd58fr9MOhP
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "mem_WZsm7QTPhVrompscmPhoGTXXcrd58fr9MOhP",
          "roles": [
            "role_admin",
            "role_owner"
          ],
          "permissions": [
            "members_read",
            "members_write",
            "create_moto_payments",
            "full_transaction_history_view",
            "refund_transactions",
            "create_referral",
            "developer_settings_edit",
            "developer_settings_access"
          ],
          "created_at": "2023-01-20T15:16:17Z",
          "updated_at": "2023-02-20T15:16:17Z",
          "user": {
            "id": "44ca0f5b-813b-46e1-aee7-e6242010662e",
            "email": "example@sumup.com",
            "mfa_on_login_enabled": true,
            "virtual_user": false,
            "service_account_user": false
          },
          "status": "accepted"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Merchant or member not found.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/members/:member_id
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
      member_id: mem_WZsm7QTPhVrompscmPhoGTXXcrd58fr9MOhP
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/not-found",
          "title": "Requested resource couldn't be found.",
          "status": 404,
          "detail": "The requested resource doesn't exist or does not belong to you."
        }
      '''
    }
  }
}
