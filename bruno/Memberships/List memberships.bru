example {
  name: 400 Response
  description: Invalid query parameter combination.
  
  request: {
    url: {{baseUrl}}/v0.1/memberships
    method: GET
    mode: none
    params:query: {
      offset: 0
      limit: 10
      kind: merchant
      ~status: accepted
      ~status: pending
      ~status: expired
      ~status: disabled
      ~status: unknown
      resource.type: merchant
      ~resource.attributes.sandbox: 
      ~resource.name: 
      ~resource.id: 
      ~resource.parent.id: 
      resource.parent.type: merchant
      roles: role_employee,role_accountant
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/bad-request",
          "title": "Bad Request",
          "status": 400,
          "detail": "Request validation failed."
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication failed or missing required scope.
  
  request: {
    url: {{baseUrl}}/v0.1/memberships
    method: GET
    mode: none
    params:query: {
      offset: 0
      limit: 10
      kind: merchant
      ~status: accepted
      ~status: pending
      ~status: expired
      ~status: disabled
      ~status: unknown
      resource.type: merchant
      ~resource.attributes.sandbox: 
      ~resource.name: 
      ~resource.id: 
      ~resource.parent.id: 
      resource.parent.type: merchant
      roles: role_employee,role_accountant
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
