meta {
  name: List memberships
  type: http
  seq: 1
  tags: [
    Memberships
  ]
}

get {
  url: {{baseUrl}}/v0.1/memberships
  body: none
  auth: inherit
}

params:query {
  @description('Offset of the first member to return.')
  offset: 0
  @description('Maximum number of members to return.')
  limit: 10
  @description('Filter memberships by resource kind.')
  kind: merchant
  @description('Filter memberships by resource kind.')
  resource.type: merchant
  @description('''
    Filter memberships by the parent of the resource the membership is in.
    Omit both `resource.parent.id` and `resource.parent.type` to skip parent filtering. When filtering by parent, both parameters must be present. To select resources without a parent, set each parameter to an empty value. Otherwise, both parameters must identify a parent.
  ''')
  resource.parent.type: merchant
  @description('Filter the returned memberships by role.')
  roles: role_employee,role_accountant
  @description('Filter the returned memberships by the membership status.')
  ~status: accepted
  @description('Filter the returned memberships by the membership status.')
  ~status: pending
  @description('Filter the returned memberships by the membership status.')
  ~status: expired
  @description('Filter the returned memberships by the membership status.')
  ~status: disabled
  @description('Filter the returned memberships by the membership status.')
  ~status: unknown
  @description('Filter memberships by the sandbox status of the resource the membership is in.')
  ~resource.attributes.sandbox: 
  @description('Filter memberships by the name of the resource the membership is in.')
  ~resource.name: 
  @description('Filter memberships by the ID of the resource the membership is in.')
  ~resource.id: 
  @description('''
    Filter memberships by the parent of the resource the membership is in.
    Omit both `resource.parent.id` and `resource.parent.type` to skip parent filtering. When filtering by parent, both parameters must be present. To select resources without a parent, set each parameter to an empty value. Otherwise, both parameters must identify a parent.
  ''')
  ~resource.parent.id: 
}

docs {
  List memberships of the current user.
}

example {
  name: 200 Response
  description: Returns a list of Membership objects.
  
  request: {
    url: {{baseUrl}}/v0.1/memberships
    method: GET
    mode: none
    params:query: {
      offset: 0
      limit: 10
      kind: merchant
      ~status: accepted
      ~status: pending
      ~status: expired
      ~status: disabled
      ~status: unknown
      resource.type: merchant
      ~resource.attributes.sandbox: 
      ~resource.name: 
      ~resource.id: 
      ~resource.parent.id: 
      resource.parent.type: merchant
      roles: role_employee,role_accountant
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "items": [
