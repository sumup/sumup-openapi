meta {
  name: Get Merchant
  type: http
  seq: 1
  tags: [
    Merchants
  ]
}

get {
  url: {{baseUrl}}/v1/merchants/:merchant_code
  body: none
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
}

docs {
  Returns a Merchant for a valid Merchant code.
}

example {
  name: 200 Response
  description: Returns a Merchant for a valid identifier.
  
  request: {
    url: {{baseUrl}}/v1/merchants/:merchant_code
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
  
      '''
    }
  }
}

example {
  name: 404 Response
  description: The requested Merchant does not exist.
  
  request: {
    url: {{baseUrl}}/v1/merchants/:merchant_code
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/not-found",
          "title": "Requested resource couldn't be found.",
          "status": 404,
          "detail": "The requested resource doesn't exist or does not belong to you.",
          "instance": ""
        }
      '''
    }
  }
}
