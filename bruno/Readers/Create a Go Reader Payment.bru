meta {
  name: Create a Go Reader Payment
  type: http
  seq: 1
  tags: [
    Readers
  ]
}

post {
  url: {{baseUrl}}/v0/merchants/:merchant_code/readers/:reader_id/go-checkout
  body: json
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
  @description('The unique identifier of the reader.')
  reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
}

body:json {
  {
    "affiliate": "",
    "client_transaction_id": "19e12390-72cf-4f9f-80b5-b0c8a67fa43f",
    "tip_amount": 200,
    "total_amount": ""
  }
}

docs {
  Initiates a payment on the SumUp Go terminal identified by the reader ID.
  
  Use `client_transaction_id` as an idempotency key: retrying the request with the same value returns the result of the original payment instead of creating a duplicate.
}

example {
  name: 200 Response
  description: Returns the result of the payment initiated on the reader.
  
  request: {
    url: {{baseUrl}}/v0/merchants/:merchant_code/readers/:reader_id/go-checkout
    method: POST
    mode: json
    params:path: {
      merchant_code: MK10CL2A
      reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
    }
  
    body:json: {
      {
        "affiliate": "",
        "client_transaction_id": "19e12390-72cf-4f9f-80b5-b0c8a67fa43f",
        "tip_amount": 200,
        "total_amount": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "client_transaction_id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
            "transaction_code": "TEENSK4W2K"
          }
        }
      '''
    }
  }
}

