example {
  name: 422 Response
  description: Response when given params (or one of them) are invalid
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id/checkout
    method: POST
    mode: json
    params:path: {
      merchant_code: MC0X0ABC
      reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
    }
  
    body:json: {
      {
        "return_url": "https://example.com/sumup/webhook",
        "total_amount": {
          "currency": "EUR",
          "minor_unit": 2,
          "value": 1500
        }
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "DataValidation": {
            "description": "Validation errors for the informed fields.",
            "value": {
              "errors": {
                "card_type": [
                  "is invalid"
                ],
                "installments": [
                  "not allowed"
                ],
                "return_url": [
                  "must be a valid URL"
                ],
                "tip_rates": [
                  "has an invalid entry"
                ],
                "total_amount": [
                  "must be greater than 0"
                ]
              }
            }
          },
          "InstallmentsTooLow": {
            "description": "Error returned when installments is not within the allowed range.",
            "value": {
              "errors": {
                "installments": [
                  "is invalid"
                ]
              }
            }
          },
          "PaymentMethodNotAllowed": {
            "description": "Error returned when the requested payment method is not supported for the merchant (e.g. pix for non-BR merchants).",
            "value": {
              "errors": {
                "detail": "Payment method not allowed for this merchant.",
                "type": "PAYMENT_METHOD_NOT_ALLOWED"
              }
            }
          },
          "ReaderBusy": {
            "description": "Error returned when a checkout was requested in the last 60 seconds.",
            "value": {
              "errors": {
                "detail": "There is a pending checkout for the device.",
                "type": "READER_BUSY"
              }
            }
          },
          "ReaderOffline": {
            "description": "Error returned when the target device is not online.",
            "value": {
              "errors": {
                "detail": "The device is offline.",
                "type": "READER_OFFLINE"
              }
            }
          }
        }
      '''
    }
  }
}

