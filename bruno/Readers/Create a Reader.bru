meta {
  name: Create a Reader
  type: http
  seq: 3
  tags: [
    Readers
  ]
}

post {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers
  body: json
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
}

body:json {
  {
    "pairing_code": "4WLFDSBF",
    "name": "Frontdesk",
    "metadata": {}
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar('UpdateReader_reader_id', res.body.id);
    bru.setVar('DeleteReader_reader_id', res.body.id);
  }
}

docs {
  Create a new Reader for the merchant account.
}

example {
  name: A reader that waits for the physical device to acknowledge the pairing.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers
    method: POST
    mode: json
    params:path: {
      merchant_code: MK10CL2A
    }
  
    body:json: {
      {
        "pairing_code": "4WLFDSBF",
        "name": "Frontdesk",
        "metadata": {}
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "rdr_3MSAFM23CK82VSTT4BN6RWSQ65",
          "name": "Frontdesk",
          "status": "processing",
          "device": {
            "identifier": "U1DT3NA00-CN",
            "model": "solo"
          },
          "created_at": "2023-05-09T14:50:20.214Z",
          "updated_at": "2023-05-09T14:52:58.714Z"
        }
      '''
    }
  }
}

example {
