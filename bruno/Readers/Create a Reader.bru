    params:path: {
      merchant_code: MK10CL2A
    }
  
    body:json: {
      {
        "pairing_code": "4WLFDSBF",
        "name": "Frontdesk",
        "metadata": {}
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
