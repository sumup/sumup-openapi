example {
  name: 422 Response
  description: The reader model is not supported, the firmware version is unsupported, or the reader could not return its settings.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id/settings
    method: GET
    mode: none
    params:path: {
      merchant_code: MC0X0ABC
      reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "errors": {
            "detail": "Reader settings are only supported for Solo readers.",
            "type": "UNSUPPORTED_DEVICE_MODEL"
          }
        }
      '''
    }
  }
}

