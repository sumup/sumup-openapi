meta {
  name: Get Reader Settings
  type: http
  seq: 9
  tags: [
    Readers
  ]
}

get {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id/settings
  body: none
  auth: inherit
}

params:path {
  @description('The merchant code of the account that owns the reader.')
  merchant_code: MC0X0ABC
  @description('The unique identifier of the reader.')
  reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
}

docs {
  Returns the menu lock settings for a Solo reader.
  
  For an online reader, returns the current settings. For an offline reader,
  returns the last saved settings, which may differ from its current configuration.
  Returns `404` if the reader is offline and no saved settings are available.
  
  The response may include the menu lock PIN.
  
}

example {
  name: 200 Response
  description: Reader settings retrieved successfully.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id/settings
    method: GET
    mode: none
    params:path: {
      merchant_code: MC0X0ABC
      reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "menu_lock": {
              "enabled": true,
              "passcode": "1234"
            }
          }
        }
      '''
    }
  }
}

