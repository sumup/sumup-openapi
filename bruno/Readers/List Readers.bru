meta {
  name: List Readers
  type: http
  seq: 2
  tags: [
    Readers
  ]
}

get {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers
  body: none
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
}

docs {
  List all readers of the merchant.
}

example {
  name: 200 Response
  description: Returns a list Reader objects.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "items": [
