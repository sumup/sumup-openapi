  }
}

example {
  name: 401 Response
  description: Authentication failed or missing required scope.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
