meta {
  name: Retrieve a Reader
  type: http
  seq: 4
  tags: [
    Readers
  ]
}

get {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id
  body: none
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
  @description('The unique identifier of the reader.')
  reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
}

headers {
  @description('''
    Return the reader only if it has been modified after the specified timestamp given in the headers.
    
    Timestamps are accepted in the following formats:
    
     - HTTP Standard: [IMF format (RFC 5322)](https://www.rfc-editor.org/rfc/rfc5322#section-3.3), sometimes also referred to as [RFC 7231](https://www.rfc-editor.org/rfc/rfc7231#section-7.1.1.1).
     - RFC 3339: Used for timestamps in JSON payloads on this API.
  ''')
  ~If-Modified-Since: 
}

docs {
  Retrieve a Reader.
}

example {
  name: 200 Response
  description: Returns a Reader object for a valid identifier.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
      reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
    }
  
    headers: {
      ~If-Modified-Since: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "rdr_3MSAFM23CK82VSTT4BN6RWSQ65",
          "name": "Frontdesk",
          "status": "paired",
          "device": {
            "identifier": "U1DT3NA00-CN",
            "model": "solo"
          },
          "metadata": {},
          "service_account_id": "",
          "created_at": "2023-01-18T15:16:17Z",
          "updated_at": "2023-01-20T15:16:17Z"
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: The requested Reader resource does not exist.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
      reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
    }
  
    headers: {
      ~If-Modified-Since: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/not-found",
          "title": "Requested resource couldn't be found.",
          "status": 404,
          "detail": "The requested resource doesn't exist or does not belong to you."
        }
      '''
    }
  }
}
