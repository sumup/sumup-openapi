example {
  name: 422 Response
  description: The settings are invalid, the reader is offline, the reader model is not supported, the firmware version is unsupported, or the reader could not apply the update.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id/settings
    method: PATCH
    mode: json
    params:path: {
      merchant_code: MC0X0ABC
      reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
    }
  
    body:json: {
      {
        "menu_lock": {
          "enabled": true,
          "passcode": "1234"
        }
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "errors": {
            "detail": "The device is offline.",
            "type": "READER_OFFLINE"
          }
        }
      '''
    }
  }
}

