meta {
  name: Update Reader Settings
  type: http
  seq: 10
  tags: [
    Readers
  ]
}

patch {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id/settings
  body: json
  auth: inherit
}

params:path {
  @description('The merchant code of the account that owns the reader.')
  merchant_code: MC0X0ABC
  @description('The unique identifier of the reader.')
  reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
}

body:json {
  {
    "menu_lock": {
      "enabled": true,
      "passcode": "1234"
    }
  }
}

docs {
  Updates the menu lock settings for a Solo reader. The reader must be online.
  A successful response confirms that the reader applied the update.
  
  Include at least one of `menu_lock.enabled` or `menu_lock.passcode`.
  Omitted settings keep their current values. The response contains only the
  settings included in the request.
  
  When enabling menu lock for a reader without a PIN, include a four-digit PIN
  in `menu_lock.passcode` in the same request.
  
}

example {
  name: 200 Response
  description: Reader settings updated successfully.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id/settings
    method: PATCH
    mode: json
    params:path: {
      merchant_code: MC0X0ABC
      reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
    }
  
    body:json: {
      {
        "menu_lock": {
          "enabled": true,
          "passcode": "1234"
        }
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "data": {
            "menu_lock": {
              "enabled": true,
              "passcode": "1234"
            },
            "status": "applied"
          }
        }
      '''
    }
  }
}

