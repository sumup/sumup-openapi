meta {
  name: Update a Reader
  type: http
  seq: 6
  tags: [
    Readers
  ]
}

patch {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id
  body: json
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
  @description('The unique identifier of the reader.')
  reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
}

body:json {
  {
    "name": "Frontdesk",
    "metadata": {}
  }
}

docs {
  Updates a reader's name or metadata and returns the updated reader.
  
  Providing `metadata` replaces the entire metadata object; include all entries that should be retained. Omitted fields remain unchanged.
}

example {
  name: 200 Response
  description: Returns the updated Reader object if the update succeeded.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id
    method: PATCH
    mode: json
    params:path: {
      merchant_code: MK10CL2A
      reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
    }
  
    body:json: {
      {
        "name": "Frontdesk",
        "metadata": {}
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "rdr_3MSAFM23CK82VSTT4BN6RWSQ65",
          "name": "Frontdesk",
          "status": "paired",
          "device": {
            "identifier": "U1DT3NA00-CN",
            "model": "solo"
          },
          "metadata": {},
          "service_account_id": "",
          "created_at": "2023-01-18T15:16:17Z",
          "updated_at": "2023-01-20T15:16:17Z"
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: The request isn't sufficiently authorized to modify the reader.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/readers/:reader_id
    method: PATCH
    mode: json
    params:path: {
      merchant_code: MK10CL2A
      reader_id: rdr_3MSAFM23CK82VSTT4BN6RWSQ65
    }
  
    body:json: {
      {
        "name": "Frontdesk",
        "metadata": {}
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/forbidden",
          "title": "Forbidden",
          "status": 403,
          "detail": "You do not have permission to perform this action."
        }
      '''
    }
  }
}

