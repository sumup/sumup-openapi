meta {
  name: Create a role
  type: http
  seq: 2
  tags: [
    Roles
  ]
}

post {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/roles
  body: json
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
}

body:json {
  {
    "name": "Senior Shop Manager II",
    "permissions": [
      "catalog_access",
      "taxes_access",
      "members_access"
    ],
    "metadata": {},
    "description": "Manges the shop and the employees."
  }
}

docs {
  Create a custom role for the merchant. Roles are defined by the set of permissions that they grant to the members that they are assigned to.
}

example {
  name: 201 Response
  description: Returns the Role object after successful custom role creation.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/roles
    method: POST
    mode: json
    params:path: {
      merchant_code: MK10CL2A
    }
  
    body:json: {
      {
        "name": "Senior Shop Manager II",
        "permissions": [
          "catalog_access",
          "taxes_access",
          "members_access"
        ],
        "metadata": {},
        "description": "Manges the shop and the employees."
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "role_WZsm7QTPhVrompscmPhoGTXXcrd58fr9MOhP",
          "name": "Senior Shop Manager II",
          "description": "Manges the shop and the employees.",
          "permissions": [],
          "is_predefined": true,
          "metadata": {},
          "created_at": "2023-01-20T15:16:17Z",
          "updated_at": "2023-01-20T15:16:17Z"
        }
      '''
    }
  }
}

