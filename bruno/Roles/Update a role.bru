meta {
  name: Update a role
  type: http
  seq: 5
  tags: [
    Roles
  ]
}

patch {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/roles/:role_id
  body: json
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
  @description('The ID of the role to retrieve.')
  role_id: role_WZsm7QTPhVrompscmPhoGTXXcrd58fr9MOhP
}

body:json {
  {
    "name": "Senior Shop Manager III",
    "permissions": [
      "catalog_edit",
      "taxes_access",
      "members_edit"
    ]
  }
}

docs {
  Updates a custom role's name, description, or permissions and returns the updated role.
  
  Providing `permissions` replaces the role's permission list and changes the access granted to members assigned to that role. Omitted fields remain unchanged.
}

example {
  name: 200 Response
  description: Returns the updated Role object if the update succeeded.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/roles/:role_id
    method: PATCH
    mode: json
    params:path: {
      merchant_code: MK10CL2A
      role_id: role_WZsm7QTPhVrompscmPhoGTXXcrd58fr9MOhP
    }
  
    body:json: {
      {
        "name": "Senior Shop Manager III",
        "permissions": [
          "catalog_edit",
          "taxes_access",
          "members_edit"
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "role_WZsm7QTPhVrompscmPhoGTXXcrd58fr9MOhP",
          "name": "Senior Shop Manager II",
          "description": "Manges the shop and the employees.",
          "permissions": [],
          "is_predefined": true,
          "metadata": {},
          "created_at": "2023-01-20T15:16:17Z",
          "updated_at": "2023-01-20T15:16:17Z"
        }
      '''
    }
  }
}

