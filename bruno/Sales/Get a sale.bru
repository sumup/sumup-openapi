meta {
  name: Get a sale
  type: http
  seq: 3
  tags: [
    Sales
  ]
}

get {
  url: {{baseUrl}}/v1.0/merchants/:merchant_code/sales/:sale_id
  body: none
  auth: inherit
}

params:path {
  @description('The merchant code.')
  merchant_code: MCZM9TGQ
  @description('The sale ID.')
  sale_id: 5965aa65-e45a-4cc1-9063-c1c1e3b8607f
}

docs {
  Returns `Sale` for `sale_id`, including item lines and `payments[]`.
  Non-finalised sales are never returned; only fully-paid sales.
}

example {
  name: 200 Response
  description: Sale data with item lines and payments.
  
  request: {
    url: {{baseUrl}}/v1.0/merchants/:merchant_code/sales/:sale_id
    method: GET
    mode: none
    params:path: {
      merchant_code: MCZM9TGQ
      sale_id: 5965aa65-e45a-4cc1-9063-c1c1e3b8607f
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "dbe3178d-4b83-5024-9b26-9b8e1b280514",
          "currency": {
            "code": "EUR",
            "scale": 2
          },
          "tax_mode": "GROSS",
          "state": "CLOSED",
          "price": {
            "net_amount": 252,
            "gross_amount": 300,
            "taxes": [
              {
                "id": "tax-vat-19",
                "net_amount": 252,
                "gross_amount": 300,
                "tax_amount": 48
              }
            ]
          },
          "created_at": "2026-06-02T10:15:00Z",
          "closed_at": "2026-06-02T10:20:00Z",
          "source": {
            "channel": "POS"
          },
          "items": [
            {
              "id": "line-1",
              "type": "CATALOG",
              "name": "Cappuccino",
              "quantity": 1,
              "unit_of_measure": {
                "group_id": "quantity",
                "unit_id": "quantity.piece",
                "unit_ratio": 1
              },
              "price": {
                "unit_amount": 300,
                "total_net_amount": 252,
                "total_gross_amount": 300,
                "taxes": [
                  {
                    "id": "tax-vat-19",
                    "net_amount": 252,
                    "gross_amount": 300,
                    "tax_amount": 48
                  }
                ],
                "total_net_amount_final": 252,
                "total_gross_amount_final": 300,
                "taxes_final": [
                  {
                    "id": "tax-vat-19",
                    "net_amount": 252,
                    "gross_amount": 300,
                    "tax_amount": 48
                  }
                ]
              }
            }
          ],
          "payments": [
            {
              "method": "apple_pay",
              "reference": "TERTYFQ4G3",
              "type": "purchase",
              "amount": 300,
              "status": "SUCCESSFUL",
              "processed_at": "2026-06-02T10:20:00Z"
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: The client is not authenticated (auth header is empty or invalid).
  
  request: {
    url: {{baseUrl}}/v1.0/merchants/:merchant_code/sales/:sale_id
    method: GET
    mode: none
    params:path: {
      merchant_code: MCZM9TGQ
      sale_id: 5965aa65-e45a-4cc1-9063-c1c1e3b8607f
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/not-found",
          "title": "Requested resource couldn't be found.",
          "status": 404,
          "detail": "The requested resource doesn't exist or does not belong to you.",
          "instance": ""
        }
      '''
    }
  }
}

