  name: 403 Response
  description: Missing `sales.read`, merchant code mismatch on the token, or no `merchant.read` permission.
  
  request: {
    url: {{baseUrl}}/v1.0/merchants/:merchant_code/sales/:sale_id
    method: GET
    mode: none
    params:path: {
      merchant_code: MCZM9TGQ
