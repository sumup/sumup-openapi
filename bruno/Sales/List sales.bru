meta {
  name: List sales
  type: http
  seq: 1
  tags: [
    Sales
  ]
}

get {
  url: {{baseUrl}}/v1.0/merchants/:merchant_code/sales
  body: none
  auth: inherit
}

params:query {
  @description('Maximum number of results per page.')
  pagination_limit: 10
  @description('''
    Opaque token from the previous list response. Omit it on the first request. To load
    the next page, pass the returned token unchanged. Not interchangeable with tokens
    from `POST /sales/search`.
  ''')
  ~pagination_token: 
}

params:path {
  @description('The merchant code.')
  merchant_code: MCZM9TGQ
}

docs {
  Returns a paginated list of `Sale` objects. Results are sorted **newest first** by the
  **newest event** recorded for each sale. Pagination tokens follow that order.
  
  Covers the merchant’s **last two years** of sales. Non-finalised sales are never returned;
  only fully-paid sales. Use `POST /sales/search` for filtered queries.
}

