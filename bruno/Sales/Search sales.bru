meta {
  name: Search sales
  type: http
  seq: 2
  tags: [
    Sales
  ]
}

post {
  url: {{baseUrl}}/v1.0/merchants/:merchant_code/sales/search
  body: json
  auth: inherit
}

params:path {
  @description('The merchant code.')
  merchant_code: MCZM9TGQ
}

body:json {
  {
    "start_date": "2026-06-01T00:00:00Z",
    "end_date": "2026-06-02T23:59:59Z",
    "sales_channels": [
      "POS"
    ],
    "pagination_limit": 10
  }
}

docs {
  Returns a paginated list of `SaleSearchItem` rows matching filter criteria. Results are
  sorted **newest first** by **sale close date**.
  
  Filters from different categories stack with **logical AND**; multiple values in one array
  field stack with **logical OR**. Results cover the merchant’s **last two years** of sales
  (narrow further with `start_date` / `end_date`). Pagination tokens are not interchangeable
  with `GET /sales`.
}

example {
  name: 200 Response (Search point-of-sale sales in a date range)
  description: Successful response with search results.
  
  request: {
    url: {{baseUrl}}/v1.0/merchants/:merchant_code/sales/search
    method: POST
    mode: json
    params:path: {
      merchant_code: MCZM9TGQ
    }
  
    body:json: {
      {
        "start_date": "2026-06-01T00:00:00Z",
        "end_date": "2026-06-02T23:59:59Z",
        "sales_channels": [
          "POS"
        ],
        "pagination_limit": 10
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "items": [
            {
              "id": "dbe3178d-4b83-5024-9b26-9b8e1b280514",
              "state": "CLOSED",
              "tax_mode": "GROSS",
              "currency": {
                "code": "EUR",
                "scale": 2
              },
              "name": "Order 1234",
              "total_amount": 1250,
              "created_at": "2026-06-01T14:30:00Z",
              "closed_at": "2026-06-01T14:35:00Z"
            }
          ],
          "pagination_token": "66bcbtzelrubzeuzruzgu76678trncH"
        }
      '''
    }
  }
}

