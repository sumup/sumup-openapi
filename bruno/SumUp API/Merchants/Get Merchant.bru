meta {
  name: Get Merchant
  type: http
  seq: 1
  tags: [
    Merchants
  ]
}

get {
  url: {{baseUrl}}/v1/merchants/:merchant_code
  body: none
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Returns a Merchant for a valid Merchant code.
}

example {
  name: 200 Response
  description: Returns a Merchant for a valid identifier.
  
  request: {
    url: {{baseUrl}}/v1/merchants/:merchant_code
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
