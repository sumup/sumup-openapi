meta {
  name: Get Person
  type: http
  seq: 3
  tags: [
    Merchants
  ]
}

get {
  url: {{baseUrl}}/v1/merchants/:merchant_code/persons/:person_id
  body: none
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MK10CL2A
  @description('Person ID')
  person_id: pers_5AKFHN2KSK8D3TS79DJE3P3A2Z
}

settings {
  forwardAuthorizationHeader: false
}

docs {
  Returns a single Person related to a Merchant.
}

example {
  name: 200 Response
  description: Returns a Person for a valid identifier.
  
  request: {
    url: {{baseUrl}}/v1/merchants/:merchant_code/persons/:person_id
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
      person_id: pers_5AKFHN2KSK8D3TS79DJE3P3A2Z
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "id": "pers_2EGQ057R6C8J791RVCG5NWAEAB",
          "user_id": "ef263f37-8701-4181-9758-acddbb778ee9",
          "birthdate": "1980-01-12",
          "given_name": "Sofia",
          "family_name": "Rossi",
          "phone_number": "+420123456789",
          "relationships": [
            "representative"
          ],
          "ownership": {
            "share": 50000
          },
          "address": {
            "street_address": [
              "Paul-Linke-Ufer 39-40",
              "2. Hinterhof"
            ],
            "post_code": "10999",
            "city": "Berlin",
            "country": "DE"
          },
          "identifiers": [
            {
              "ref": "br.cpf",
              "value": "847.060.136-90"
            }
          ],
          "citizenship": "AR",
          "nationality": "",
          "country_of_residence": "",
          "version": "chng_01HS0KG3MPVEVWW85E3KNXH55J",
          "change_status": ""
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: The requested Person does not exist.
  
  request: {
    url: {{baseUrl}}/v1/merchants/:merchant_code/persons/:person_id
    method: GET
    mode: none
    params:path: {
      merchant_code: MK10CL2A
      person_id: pers_5AKFHN2KSK8D3TS79DJE3P3A2Z
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/not-found",
          "title": "Requested resource couldn't be found.",
          "status": 404,
          "detail": "The requested resource doesn't exist or does not belong to you.",
          "instance": ""
        }
      '''
    }
  }
}
