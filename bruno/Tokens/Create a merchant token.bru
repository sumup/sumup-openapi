meta {
  name: Create a merchant token
  type: http
  seq: 1
  tags: [
    Tokens
  ]
}

post {
  url: {{baseUrl}}/v0.1/merchants/:merchant_code/tokens
  body: json
  auth: inherit
}

params:path {
  @description('Unique code of the merchant account that will receive the payments.')
  merchant_code: MC0X0ABC
}

body:json {
  {
    "actions": [
      "checkout"
    ]
  }
}

docs {
  Creates a short-lived token for the merchant account identified by `merchant_code` and the requested actions.
  
  Call this endpoint from your backend using a [supported authentication method](https://developer.sumup.com/api/authentication). You must have access to the merchant account. Before returning the token, check that the user signed in to your application is allowed to accept payments for that account.
  
  Pass the returned `access_token` to the SDK. The token expires 15 minutes after creation; use `expires_in` for its remaining lifetime. To continue after it expires, create a new token through this endpoint.
}

example {
  name: 200 Response
  description: Merchant token created. Pass its access_token to the SDK.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/tokens
    method: POST
    mode: json
    params:path: {
      merchant_code: MC0X0ABC
    }
  
    body:json: {
      {
        "actions": [
          "checkout"
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "access_token": "MERCHANT_TOKEN",
          "token_type": "Bearer",
          "expires_in": 899
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: The request body is invalid or contains unsupported or duplicate actions.
  
  request: {
    url: {{baseUrl}}/v0.1/merchants/:merchant_code/tokens
    method: POST
    mode: json
    params:path: {
      merchant_code: MC0X0ABC
    }
  
    body:json: {
      {
        "actions": [
          "checkout"
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/bad-request",
          "title": "Bad Request",
          "status": 400,
          "detail": "The request contains an unsupported action."
        }
      '''
    }
  }
}

