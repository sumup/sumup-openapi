      ~payment_types[]: BOLETO
      ~payment_types[]: DIRECT_DEBIT
      ~payment_types[]: APM
      ~payment_types[]: UNKNOWN
      ~entry_modes[]: none
      ~entry_modes[]: magstripe
      ~entry_modes[]: chip
      ~entry_modes[]: manual entry
      ~entry_modes[]: customer entry
      ~entry_modes[]: magstripe fallback
