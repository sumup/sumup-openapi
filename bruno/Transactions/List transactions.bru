      ~entry_modes[]: bancontact
      ~entry_modes[]: eps
      ~entry_modes[]: mybank
      ~entry_modes[]: satispay
      ~entry_modes[]: blik
      ~entry_modes[]: p24
      ~entry_modes[]: giropay
      ~entry_modes[]: pix
      ~entry_modes[]: qr code pix
      ~entry_modes[]: apple pay
      ~entry_modes[]: google pay
      ~entry_modes[]: sumup gift card
      ~entry_modes[]: paypal
      ~entry_modes[]: twint
      ~entry_modes[]: iris
      ~entry_modes[]: sumup pay
      ~entry_modes[]: na
      ~types[]: PAYMENT
      ~types[]: REFUND
      ~types[]: CHARGE_BACK
      changes_since: 2019-08-28T09:00:00Z
      newest_time: 2019-08-29T09:00:00Z
      newest_ref: 090df9bf-93b7-40f1-8181-fbdb236568a1
      oldest_time: 2019-08-28T09:00:00Z
      oldest_ref: 090df9bf-93b7-40f1-8181-fbdb236568a1
