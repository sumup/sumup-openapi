meta {
  name: List transactions
  type: http
  seq: 3
  tags: [
    Transactions
  ]
}

get {
  url: {{baseUrl}}/v2.1/merchants/:merchant_code/transactions/history
  body: none
  auth: inherit
}

params:query {
  @description('Retrieves the transaction resource with the specified transaction code.')
  transaction_code: TEENSK4W2K
  @description('Sort direction for the transaction history. Use `ascending` or `descending`; the default is `ascending`.')
  order: ascending
  @description('Maximum number of transactions per page. Must be a positive integer. Defaults to `10` when omitted; a page can contain fewer results.')
  limit: 10
  @description('Filters transactions by user email. For multiple values, repeat the query parameter, for example `users[]=first@example.com&users[]=second@example.com`.')
  users[]: merchant@example.com
  @description('Filters the results by the latest modification time of resources and returns only transactions that are modified *at or after* the specified timestamp (in [ISO8601](https://en.wikipedia.org/wiki/ISO_8601) format).')
  changes_since: 2019-08-28T09:00:00Z
  @description('Filters the results by the creation time of resources and returns only transactions that are created *before* the specified timestamp (in [ISO8601](https://en.wikipedia.org/wiki/ISO_8601) format).')
  newest_time: 2019-08-29T09:00:00Z
  @description('Pagination reference that returns results before the specified reference. Use the value from a returned pagination link rather than constructing it yourself. This parameter takes precedence over `newest_time` when both are provided.')
  newest_ref: 090df9bf-93b7-40f1-8181-fbdb236568a1
  @description('Filters the results by the creation time of resources and returns only transactions that are created *at or after* the specified timestamp (in [ISO8601](https://en.wikipedia.org/wiki/ISO_8601) format).')
  oldest_time: 2019-08-28T09:00:00Z
  @description('Pagination reference that returns results after the specified reference. Use the value from a returned pagination link rather than constructing it yourself. This parameter takes precedence over `oldest_time` when both are provided.')
  oldest_ref: 090df9bf-93b7-40f1-8181-fbdb236568a1
  @description('Sort direction for the transaction history. Use `ascending` or `descending`; the default is `ascending`.')
  ~order: descending
  @description('Filters transactions by the listed final statuses. For multiple values, repeat the query parameter, for example `statuses[]=SUCCESSFUL&statuses[]=REFUNDED`.')
  ~statuses[]: SUCCESSFUL
  @description('Filters transactions by the listed final statuses. For multiple values, repeat the query parameter, for example `statuses[]=SUCCESSFUL&statuses[]=REFUNDED`.')
  ~statuses[]: CANCELLED
  @description('Filters transactions by the listed final statuses. For multiple values, repeat the query parameter, for example `statuses[]=SUCCESSFUL&statuses[]=REFUNDED`.')
  ~statuses[]: FAILED
  @description('Filters transactions by the listed final statuses. For multiple values, repeat the query parameter, for example `statuses[]=SUCCESSFUL&statuses[]=REFUNDED`.')
  ~statuses[]: REFUNDED
  @description('Filters transactions by the listed final statuses. For multiple values, repeat the query parameter, for example `statuses[]=SUCCESSFUL&statuses[]=REFUNDED`.')
  ~statuses[]: CHARGE_BACK
  @description('Filters the returned results by the specified list of payment types used for the transactions.')
  ~payment_types[]: CASH
  @description('Filters the returned results by the specified list of payment types used for the transactions.')
  ~payment_types[]: POS
  @description('Filters the returned results by the specified list of payment types used for the transactions.')
