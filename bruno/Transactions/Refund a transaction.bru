example {
  name: Transaction_Not_Refundable (Full refund)
  description: The state of the identified transaction resource does not permit the requested operation.
  
  request: {
    url: {{baseUrl}}/v1.0/merchants/:merchant_code/payments/:transaction_id/refunds
    method: POST
    mode: json
    params:path: {
