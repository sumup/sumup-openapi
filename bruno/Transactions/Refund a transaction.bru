    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/conflict",
          "title": "Conflict",
          "status": 409,
          "detail": "The transaction is not refundable in its current state"
        }
      '''
    }
  }
}

