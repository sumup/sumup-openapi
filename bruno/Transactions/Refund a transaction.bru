meta {
  name: Refund a transaction
  type: http
  seq: 1
  tags: [
    Transactions
  ]
}

post {
  url: {{baseUrl}}/v1.0/merchants/:merchant_code/payments/:transaction_id/refunds
  body: json
  auth: inherit
}

params:path {
  @description('Short unique identifier for the merchant.')
  merchant_code: MH4H92C7
  @description('Unique identifier of the transaction.')
  transaction_id: 4ffb8dfc-7f2b-413d-a497-2ad00766585e
}

body:json {
  {}
}

docs {
  Refunds a transaction identified by its SumUp transaction ID. Omit the request body to request a full refund, or provide `amount` for a partial refund in the transaction's currency.
  
  Retrieve the transaction afterwards to inspect its refunded amount and refund events. The transaction must be eligible for a refund; see the error responses for invalid amounts, permissions, and processing failures.
}

example {
  name: 201 Response (Full refund)
  description: The transaction was refunded in full or partially based on the request.
  
  request: {
    url: {{baseUrl}}/v1.0/merchants/:merchant_code/payments/:transaction_id/refunds
    method: POST
    mode: json
    params:path: {
      merchant_code: MH4H92C7
      transaction_id: 4ffb8dfc-7f2b-413d-a497-2ad00766585e
    }
  
    body:json: {
      {}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}

example {
  name: 201 Response (Partial refund)
  description: The transaction was refunded in full or partially based on the request.
  
  request: {
    url: {{baseUrl}}/v1.0/merchants/:merchant_code/payments/:transaction_id/refunds
    method: POST
    mode: json
    params:path: {
      merchant_code: MH4H92C7
      transaction_id: 4ffb8dfc-7f2b-413d-a497-2ad00766585e
    }
  
    body:json: {
      {
        "amount": 24.42
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {}
      '''
    }
  }
}

example {
  name: Invalid_Amount (Full refund)
  description: The refund amount is invalid.
  
  request: {
    url: {{baseUrl}}/v1.0/merchants/:merchant_code/payments/:transaction_id/refunds
    method: POST
    mode: json
    params:path: {
      merchant_code: MH4H92C7
      transaction_id: 4ffb8dfc-7f2b-413d-a497-2ad00766585e
    }
  
    body:json: {
      {}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/bad-request",
          "title": "Bad Request",
          "status": 400,
          "detail": "amount must be greater than zero"
        }
      '''
    }
  }
}

