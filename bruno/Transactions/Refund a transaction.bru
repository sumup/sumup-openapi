example {
  name: Refund_Failed (Full refund)
  description: The payment processor rejected the refund.
  
  request: {
    url: {{baseUrl}}/v1.0/merchants/:merchant_code/payments/:transaction_id/refunds
    method: POST
    mode: json
    params:path: {
      merchant_code: MH4H92C7
      transaction_id: 4ffb8dfc-7f2b-413d-a497-2ad00766585e
    }
  
    body:json: {
      {}
    }
  }
  
  response: {
    headers: {
      Content-Type: application/problem+json
    }
  
    status: {
      code: 422
      text: Unprocessable Entity
    }
  
    body: {
      type: json
      content: '''
        {
          "type": "https://developer.sumup.com/problem/unprocessable-entity",
          "title": "Unprocessable Entity",
          "status": 422,
          "detail": "Refund failed.",
          "errors": [
            {
              "code": "INVALID_AMOUNT",
              "detail": "Amount exceeds the refundable amount",
              "reason": "amount_too_high",
              "max_refundable_amount": 1000
            }
          ]
        }
      '''
    }
  }
}

