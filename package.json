{
  "name": "sumup-api-collections",
  "private": true,
  "version": "1.0.0",
  "devDependencies": {
    "@usebruno/cli": "4.3.0",
    "openapi-to-postmanv2": "6.4.3"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "npm run generate:postman && npm run generate:bruno",
    "generate:postman": "openapi2postmanv2 -s openapi.json -o SumUpAPICollection.json -p -O folderStrategy=Tags,includeAuthInfoInExample=false,alwaysInheritAuthentication=true",
    "generate:bruno": "node scripts/generate-bruno.mjs"
  }
}
